   "source": [
    "## 4. Clean & Preprocess the Data\n",
    "### 4.1 Normalize inconsistent text casing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Before cleaning - product_category sample values:\n",
      "['BAKING GOODS', 'BREADS', 'BREAKFAST', 'Baking Goods', 'Breads', 'Breakfast', 'CANNED', 'Canned', 'DAIRY', 'Dairy']\n",
      "\n",
      "Before cleaning - fat_content values: ['Low Fat', 'Regular']\n",
      "\n",
      "After cleaning - product_category sample values:\n",
      "['Baking Goods', 'Breads', 'Breakfast', 'Canned', 'Dairy', 'Frozen Foods', 'Fruits And Vegetables', 'Hard Drinks', 'Health And Hygiene', 'Household']\n",
      "After cleaning - fat_content values: ['Low Fat', 'Regular']\n",
      "\n",
      "Non-consumable categories found with a fat_content label (data quality issue):\n",
      "fat_content\n",
      "Low Fat    1284\n",
      "Name: count, dtype: int64\n",
      "\n",
      "-> Non-consumables (Household, Health And Hygiene, Others) don't have a meaningful\n",
      "   fat content, so their fat_content is reset to 'Not Applicable'.\n"
     ]
    }
   ],
   "source": [
    "print(\"Before cleaning - product_category sample values:\")\n",
    "print(sorted(train['product_category'].unique())[:10])\n",
    "print(\"\\nBefore cleaning - fat_content values:\", sorted(train['fat_content'].unique()))\n",
    "\n",
    "for df in [train, test]:\n",
    "    df['product_category'] = df['product_category'].str.strip().str.title()\n",
    "    df['fat_content'] = df['fat_content'].str.strip().str.title()\n",
    "\n",
    "print(\"\\nAfter cleaning - product_category sample values:\")\n",
    "print(sorted(train['product_category'].unique())[:10])\n",
    "print(\"After cleaning - fat_content values:\", sorted(train['fat_content'].unique()))\n",
    "\n",
    "non_consumable = ['Household', 'Health And Hygiene', 'Others']\n",
    "print(\"\\nNon-consumable categories found with a fat_content label (data quality issue):\")\n",
    "print(train[train['product_category'].isin(non_consumable)]['fat_content'].value_counts())\n",
    "\n",
    "for df in [train, test]:\n",
    "    df.loc[df['product_category'].isin(non_consumable), 'fat_content'] = 'Not Applicable'\n",
    "\n",
    "print(\"\\n-> Non-consumables (Household, Health And Hygiene, Others) don't have a meaningful\")\n",
    "print(\"   fat content, so their fat_content is reset to 'Not Applicable'.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.2 Impute `product_weight_kg` \u2014 a product should weigh (almost) the same everywhere it's sold"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Missing product_weight_kg before imputation: train=1225, test=306\n",
      "\n",
      "Same product_code across records has near-identical weight (median range = 0.440 kg) -> safe to impute by product_code mean.\n",
      "\n",
      "Missing product_weight_kg after imputation: train=0, test=0\n"
     ]
    }
   ],
   "source": [
    "print(f\"Missing product_weight_kg before imputation: train={train['product_weight_kg'].isnull().sum()}, \"\n",
    "      f\"test={test['product_weight_kg'].isnull().sum()}\")\n",
    "\n",
    "dup_check = pd.concat([train[['product_code','product_weight_kg']], test[['product_code','product_weight_kg']]])\n",
    "per_prod_range = dup_check.groupby('product_code')['product_weight_kg'].agg(['min','max']).dropna()\n",
    "print(f\"\\nSame product_code across records has near-identical weight (median range = \"\n",
    "      f\"{(per_prod_range['max']-per_prod_range['min']).median():.3f} kg) -> safe to impute by product_code mean.\")\n",
    "\n",
    "combo_w = pd.concat([train[['product_code','product_weight_kg']], test[['product_code','product_weight_kg']]])\n",
    "w_map = combo_w.groupby('product_code')['product_weight_kg'].mean()\n",
    "for df in [train, test]:\n",
    "    df['product_weight_kg'] = df['product_weight_kg'].fillna(df['product_code'].map(w_map))\n",
    "\n",
    "# fallback for products with NO known weight anywhere: category mean\n",
    "cat_w = pd.concat([train, test]).groupby('product_category')['product_weight_kg'].mean()\n",
    "for df in [train, test]:\n",
    "    df['product_weight_kg'] = df['product_weight_kg'].fillna(df['product_category'].map(cat_w))\n",
    "\n",
    "print(f\"\\nMissing product_weight_kg after imputation: train={train['product_weight_kg'].isnull().sum()}, \"\n",
    "      f\"test={test['product_weight_kg'].isnull().sum()}\")\n"
   ]
