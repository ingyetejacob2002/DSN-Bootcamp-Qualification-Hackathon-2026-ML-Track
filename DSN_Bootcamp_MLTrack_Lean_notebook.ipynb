      "\n",
      "*** This configuration scored 1070.66 RMSE on the competition's public leaderboard. ***\n"
     ]
    }
   ],
   "source": [
    "feat_cols = ['store_code_te', 'product_category_te', 'store_format_te', 'product_price',\n",
    "             'store_age_years', 'vis_ratio_product', 'product_weight_kg', 'shelf_visibility', 'product_te']\n",
    "X = train[feat_cols]\n",
    "y = train['total_sales'].values\n",
    "X_test = test[feat_cols]\n",
    "\n",
    "print(\"Model: a blend of ExtraTreesRegressor (90%) + RandomForestRegressor (10%).\")\n",
    "print(\"Features used:\", feat_cols)\n",
    "\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=RNG)\n",
    "oof_et = np.zeros(len(X)); oof_rf = np.zeros(len(X))\n",
    "fold_rmses = []\n",
    "for fold, (tr_idx, val_idx) in enumerate(kf.split(X)):\n",
    "    et = ExtraTreesRegressor(n_estimators=600, max_depth=9, min_samples_leaf=20, random_state=RNG, n_jobs=1)\n",
    "    et.fit(X.iloc[tr_idx], y[tr_idx])\n",
    "    oof_et[val_idx] = et.predict(X.iloc[val_idx])\n",
    "\n",
    "    rf = RandomForestRegressor(n_estimators=400, max_depth=9, min_samples_leaf=30, random_state=RNG, n_jobs=1)\n",
    "    rf.fit(X.iloc[tr_idx], y[tr_idx])\n",
    "    oof_rf[val_idx] = rf.predict(X.iloc[val_idx])\n",
    "\n",
    "    blend_fold = 0.9*oof_et[val_idx] + 0.1*oof_rf[val_idx]\n",
    "    fold_rmse = np.sqrt(mean_squared_error(y[val_idx], blend_fold))\n",
    "    fold_rmses.append(fold_rmse)\n",
    "    print(f\"Fold {fold+1}: RMSE = {fold_rmse:.2f}\")\n",
    "\n",
    "oof_blend = 0.9*oof_et + 0.1*oof_rf\n",
    "cv_rmse = np.sqrt(mean_squared_error(y, oof_blend))\n",
    "print(f\"\\nMean fold RMSE: {np.mean(fold_rmses):.2f}  (+/- {np.std(fold_rmses):.2f})\")\n",
    "print(f\"Overall out-of-fold CV RMSE: {cv_rmse:.2f}\")\n",
    "print(f\"\\n*** This configuration scored 1070.66 RMSE on the competition's public leaderboard. ***\")\n"
   ]
  },
