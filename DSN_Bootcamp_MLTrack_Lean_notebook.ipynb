   "source": [
    "### 5.2 KFold-safe target encoding\n",
    "Mean `total_sales` per category, computed **only from other folds** so a row's own target never leaks into its own feature \u2014 critical since `store_code` (10 stores) and `product_code` (1,555 products) are strong but high-cardinality signals."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Building KFold-safe target encodings (mean total_sales per category, computed only\n",
      "from OTHER folds so we never leak a row's own target into its own feature value):\n",
      "\n",
      "  store_code_te  (smoothing=10)\n",
      "  product_category_te  (smoothing=10)\n",
      "  store_format_te  (smoothing=10)\n",
      "  product_te  (smoothing=3) -> 4443 of train's\n",
      "  product codes and 1699 of test's 1082\n",
      "  unique products also appear in the other split, so product-level history transfers.\n"
     ]
    },
    {
     "output_type": "display_data",
     "data": {
      "image/png": ""
     },
     "metadata": {
      "image/png": {
       "width": 900
      }
     }
    }
   ],
   "source": [
    "def kfold_target_encode(tr, te, col, target, n_splits=5, seed=RNG, smoothing=10):\n",
    "    kf_ = KFold(n_splits=n_splits, shuffle=True, random_state=seed)\n",
    "    global_mean = tr[target].mean()\n",
    "    train_enc = np.zeros(len(tr))\n",
    "    for tr_idx, val_idx in kf_.split(tr):\n",
    "        means = tr.iloc[tr_idx].groupby(col)[target].mean()\n",
    "        counts = tr.iloc[tr_idx].groupby(col)[target].count()\n",
    "        smoothed = (means * counts + global_mean * smoothing) / (counts + smoothing)\n",
    "        train_enc[val_idx] = tr.iloc[val_idx][col].map(smoothed).fillna(global_mean).values\n",
    "    means = tr.groupby(col)[target].mean()\n",
    "    counts = tr.groupby(col)[target].count()\n",
    "    smoothed_full = (means * counts + global_mean * smoothing) / (counts + smoothing)\n",
    "    test_enc = te[col].map(smoothed_full).fillna(global_mean).values\n",
    "    return train_enc, test_enc\n",
    "\n",
    "print(\"Building KFold-safe target encodings (mean total_sales per category, computed only\")\n",
    "print(\"from OTHER folds so we never leak a row's own target into its own feature value):\\n\")\n",
    "for col, sm in [('store_code', 10), ('product_category', 10), ('store_format', 10)]:\n",
    "    train[col + '_te'], test[col + '_te'] = kfold_target_encode(train, test, col, 'total_sales', smoothing=sm)\n",
    "    print(f\"  {col}_te  (smoothing={sm})\")\n",
    "\n",
    "train['product_te'], test['product_te'] = kfold_target_encode(train, test, 'product_code', 'total_sales', smoothing=3)\n",
    "overlap_train = train['product_code'].isin(test['product_code']).sum()\n",
    "overlap_test = test['product_code'].isin(train['product_code']).sum()\n",
    "print(f\"  product_te  (smoothing=3) -> {overlap_train} of train's rows and {overlap_test} of test's \"\n",
    "      f\"{test['product_code'].nunique()} unique products also appear in the other split,\")\n",
    "print(\"  so product-level history transfers between train and test.\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12,4.5))\n",
    "ord_store = train.groupby('store_code')['store_code_te'].mean().sort_values(ascending=False).index\n",
    "sns.boxplot(data=train, x='store_code', y='store_code_te', order=ord_store, ax=axes[0], hue='store_code', palette=\"viridis\", legend=False)\n",
    "axes[0].set_title(\"store_code_te by store (encoded avg sales)\")\n",
    "axes[0].tick_params(axis='x', rotation=60)\n",
    "\n",
    "sns.scatterplot(data=train.sample(2000, random_state=RNG), x='product_te', y='total_sales', alpha=0.4, s=15, ax=axes[1], color=\"#e6550d\")\n",
    "axes[1].set_title(\"product_te vs actual total_sales\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
