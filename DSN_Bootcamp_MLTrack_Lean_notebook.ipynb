    "fig, axes = plt.subplots(1, 3, figsize=(16,4.5))\n",
    "\n",
    "axes[0].scatter(y, oof_blend, alpha=0.3, s=10, color=\"#3182bd\")\n",
    "lims = [0, max(y.max(), oof_blend.max())]\n",
    "axes[0].plot(lims, lims, 'r--', linewidth=1.5)\n",
    "axes[0].set_xlabel(\"Actual total_sales\"); axes[0].set_ylabel(\"Predicted total_sales\")\n",
    "axes[0].set_title(\"Actual vs Predicted (out-of-fold)\")\n",
    "\n",
